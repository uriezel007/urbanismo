# Copy to .env locally. Never commit the real file.
# Generate two independent strong values; no default password is supplied.
POSTGRES_ADMIN_PASSWORD=
PHEI_DB_PASSWORD=
# Percent-encode any special characters in the database password.
DATABASE_URL=postgresql://phei_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/phei
APP_ORIGIN=https://YOUR_PHEI_DOMAIN
